<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>WalkingTec.Mvvm</Description>
    <AssemblyName>WalkingTec.Mvvm.Mvc</AssemblyName>
    <CopyRefAssembliesToPublishDirectory>true</CopyRefAssembliesToPublishDirectory>
    <LangVersion>latest</LangVersion>
    <Title>$(AssemblyName)</Title>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <Import Project="..\..\common.props" />

  <ItemGroup>
    <EmbeddedResource Include="Views\**\*.cshtml" />
    <None Remove="fonts\Candara.ttf" />
    <None Remove="GeneratorFiles\Spa\Vue3\Create.txt" />
    <None Remove="GeneratorFiles\Spa\Vue3\Details.txt" />
    <None Remove="GeneratorFiles\Spa\Vue3\Edit.txt" />
    <None Remove="GeneratorFiles\Spa\Vue3\Import.txt" />
    <None Remove="GeneratorFiles\Spa\Vue3\Index.txt" />
    <None Remove="GeneratorFiles\Spa\Vue3\indexapi.txt" />
    <Content Include="fonts\Candara.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="GeneratorFiles\ApiTest.txt" />
    <EmbeddedResource Include="GeneratorFiles\ApiTestTopPoco.txt" />
    <EmbeddedResource Include="GeneratorFiles\BatchVM.txt" />
    <EmbeddedResource Include="GeneratorFiles\CrudVM.txt" />
    <EmbeddedResource Include="GeneratorFiles\HeaderFormat.txt" />
    <EmbeddedResource Include="GeneratorFiles\ImportVM.txt" />
    <EmbeddedResource Include="GeneratorFiles\ListVM.txt" />
    <EmbeddedResource Include="GeneratorFiles\Searcher.txt" />
    <EmbeddedResource Include="GeneratorFiles\Spa\Controller.txt" />
    <EmbeddedResource Include="GeneratorFiles\Spa\Vue3\Create.txt" />
    <EmbeddedResource Include="GeneratorFiles\Spa\Vue3\Details.txt" />
    <EmbeddedResource Include="GeneratorFiles\Spa\Vue3\Edit.txt" />
    <EmbeddedResource Include="GeneratorFiles\Spa\Vue3\Import.txt" />
    <EmbeddedResource Include="GeneratorFiles\Spa\Vue3\Index.txt" />
    <EmbeddedResource Include="GeneratorFiles\Spa\Vue3\indexapi.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DUWENINK.Captcha" Version="0.10.2" />
    <PackageReference Include="Elsa.Activities.Email" Version="2.17.0" />
    <PackageReference Include="Elsa.Activities.Http" Version="2.17.0" />
    <PackageReference Include="Elsa.Activities.Temporal.Quartz" Version="2.17.0" />
    <PackageReference Include="Elsa.Persistence.EntityFramework.MySql" Version="2.17.0" />
    <PackageReference Include="Elsa.Persistence.EntityFramework.Oracle" Version="2.17.0" />
    <PackageReference Include="Elsa.Persistence.EntityFramework.PostgreSql" Version="2.17.0" />
    <PackageReference Include="Elsa.Persistence.EntityFramework.Sqlite" Version="2.17.0" />
    <PackageReference Include="Elsa.Persistence.EntityFramework.SqlServer" Version="2.17.0" />
    <PackageReference Include="Elsa.Server.Api" Version="2.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.1.7" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.1.7" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.7" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.6.1" />
    <PackageReference Include="VueCliMiddleware" Version="6.0.0" />
  </ItemGroup>


  <ItemGroup>
    <!-- LayUI TagHelpers项目已移除；原经由其传递引用的Core改为直接引用 -->
    <ProjectReference Include="..\WalkingTec.Mvvm.Core\WalkingTec.Mvvm.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <None Update="fonts\impact.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="fonts\monbaiti.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="fonts\STCAIYUN.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
